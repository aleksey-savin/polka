{
  "name": "polka",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun --bun node_modules/.bin/drizzle-kit generate",
    "auth:schema": "bun --bun node_modules/.bin/better-auth generate --config scripts/auth-schema.config.ts --output src/db/schema/auth.ts --yes",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-router": "1.170.25",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.42",
    "barcode-detector": "3.2.1",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.27",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
